# 复制本文件为 .env 并填入真实密钥，.env 文件不应提交到 git

# Anthropic API Key（必填，用于 LLM 调用）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 图像生成提供商：mock | replicate | comfy（默认 mock）
IMAGE_PROVIDER=mock

# Replicate API Token（使用 Replicate 出图时必填）
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxx

# 调试模式（true / false）
DEBUG=true
