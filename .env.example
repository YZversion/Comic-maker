# Copy this file to .env and fill your real keys.
# Never commit .env to git.

# DeepSeek LLM (required)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# Image provider: mock | siliconflow | liblib
# Default is liblib in config.py
IMAGE_PROVIDER=liblib

# SiliconFlow (required when IMAGE_PROVIDER=siliconflow)
# SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# LiblibAI (required when IMAGE_PROVIDER=liblib)
LIBLIB_ACCESS_KEY=xxxxxxxxxxxxxxxx
LIBLIB_SECRET_KEY=xxxxxxxxxxxxxxxx
# Optional custom template; leave empty to use built-in default
LIBLIB_TEMPLATE_UUID=

# Runtime flags
DEBUG=true
LOG_FALLBACKS=true
